@inject AppState State

@{
    var issues = State.Data.Issues;
    var shown = issues.Where(i => (severity is null || i.Severity == severity) && (source == "" || i.Source == source)).ToList();
}

<section class="card">
    <h2>Input data quality</h2>
    <p class="muted">
        What we found in the four exports and how the app dealt with it. Nothing is silently corrected or dropped.
        An <b>error</b> is a problem that changed the results (e.g. a dropped record); a <b>warning</b> is a correction or suspicion that someone should verify;
        <b>info</b> is cosmetic (date format, letter case).
    </p>
    <div class="kpis small">
        @foreach (var s in new[] { IssueSeverity.Error, IssueSeverity.Warning, IssueSeverity.Info })
        {
            <button class="kpi click @(severity == s ? "sel" : "")" @onclick="() => severity = severity == s ? null : s">
                <div class="n">@issues.Count(i => i.Severity == s)</div>@Format.Label(s)</button>
        }
    </div>
    <div class="filters">
        <select value="@source" @onchange="e => source = e.Value?.ToString() ?? string.Empty" aria-label="Source">
            <option value="">All sources</option>
            @foreach (var s in issues.Select(i => i.Source).Distinct()) { <option>@s</option> }
        </select>
        <span class="muted">@shown.Count records</span>
    </div>
    <div class="tablewrap">
        <table>
            <thead><tr><th>Source</th><th>Type</th><th>Reference</th><th>Problem</th><th>Resolution</th></tr></thead>
            <tbody>
            @foreach (var i in shown)
            {
                <tr><td>@i.Source</td><td><span class="tag sev-@i.Severity">@Format.Label(i.Severity)</span></td><td>@i.Ref</td><td>@i.Description</td><td>@i.Resolution</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>

@code {
    private IssueSeverity? severity;
    private string source = "";
}
