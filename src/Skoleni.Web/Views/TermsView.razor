@implements IDisposable
@inject AppState State

<section class="card">
    <h2>Scheduled terms</h2>
    <div class="tablewrap">
        <table>
            <thead><tr><th>Term</th><th>Training</th><th>Date and place</th><th>Capacity</th><th>Price</th><th>Notes</th></tr></thead>
            <tbody>
            @foreach (var t in State.Data.Terms)
            {
                var past = t.Date < State.AsOf;
                var added = State.Plan.ForTerm(t.Id).Count();
                var notes = new List<string>();
                if (t.ExcludedReason is not null) notes.Add($"unusable: {t.ExcludedReason}");
                else if (past) notes.Add("took place before the chosen date");
                if (t.Weekend) notes.Add("weekend");
                if (t.Booked > t.Capacity) notes.Add("overbooked");
                if (t.PriceEstimated) notes.Add("price estimated");
                <tr class="@(t.ExcludedReason is not null || past ? "dim" : "")">
                    <td>@t.Id</td>
                    <td>@(State.CourseByCode.TryGetValue(t.CourseCode, out var c) ? c.Name : t.CourseCode)</td>
                    <td>@Format.Date(t.Date) @Format.TimeRange(t.Start, t.End)<div class="muted">@t.Place</div></td>
                    <td>@t.Booked/@t.Capacity
                        @if (t.Usable && !past) { <div class="muted">free @t.FreeSeats@(added > 0 ? $", plan +{added}" : "")</div> }</td>
                    <td>@(t.Price is { } p ? Format.Money(p) : "–")</td>
                    <td>@foreach (var n in notes) { <span class="tag">@n</span> }</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;
}
