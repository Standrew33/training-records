@implements IDisposable
@inject AppState State

@{
    var plan = State.Plan;
    var coursesByCode = State.CourseByCode;
    var terms = State.Data.Terms.Where(t => t.Usable && t.Date >= State.AsOf && plan.ForTerm(t.Id).Any() && (course == "" || t.CourseCode == course)).ToList();
    string csvHref = CsvWriter.ToDataUri(CsvWriter.Write(
        ["Term", "Date", "Time", "Place", "Training", "Employee", "ID", "Department", "Manager", "Reason", "Valid until", "Note"],
        plan.Assignments.OrderBy(a => a.Term.Date).ThenBy(a => a.Requirement.Employee.LastName, StringComparer.CurrentCulture).Select(a => new string?[]
        {
            a.Term.Id, a.Term.Date?.ToString("yyyy-MM-dd"), $"{a.Term.Start:HH\\:mm}-{a.Term.End:HH\\:mm}", a.Term.Place, coursesByCode[a.Term.CourseCode].Name,
            a.Requirement.Employee.FullName, a.Requirement.Employee.Id, a.Requirement.Employee.Department, State.ManagerName(a.Requirement.Employee),
            Format.Label(a.Requirement.Status), a.Requirement.ValidUntil?.ToString("yyyy-MM-dd"), a.WillLapse ? "term is after expiry" : "",
        })));
}

<section class="card">
    <h2>Recommended sign-ups</h2>
    <p class="muted">
        Method: first people whose training has already expired or is missing, then those whose validity ends soonest. Each gets the nearest term with a free seat
        that meets the deadline (otherwise the nearest possible one). Capacity (capacity − already booked), collisions for the same person and the end of
        employment are respected. People on parental leave and terminated employees are not planned.
        The app <b>does not know who already holds the "booked" seats</b> – verify that before sending anything out.
    </p>
    <div class="kpis small">
        <div class="kpi"><div class="n">@plan.Assignments.Count</div>proposed sign-ups</div>
        <div class="kpi"><div class="n">@Format.Money(plan.EstimatedCost)</div>estimated cost</div>
        <div class="kpi @(plan.Assignments.Any(a => a.WillLapse) ? "warn" : "")"><div class="n">@plan.Assignments.Count(a => a.WillLapse)</div>will lapse before their term</div>
        <div class="kpi @(plan.Unassigned.Count > 0 ? "warn" : "")"><div class="n">@plan.Unassigned.Count</div>without a term</div>
    </div>
    <table>
        <thead><tr><th>Training</th><th>Needed</th><th>Free seats</th><th>Not covered</th></tr></thead>
        <tbody>
        @foreach (var c in plan.Coverage)
        {
            <tr><td>@coursesByCode[c.CourseCode].Name</td><td>@c.Needed</td><td>@c.FreeSeats</td>
                <td>@if (c.Shortfall > 0) { <span class="badge bad">@c.Shortfall – schedule a term</span> } else { <text>0</text> }</td></tr>
        }
        </tbody>
    </table>
    <div class="filters">
        <select value="@course" @onchange="e => course = e.Value?.ToString() ?? string.Empty" aria-label="Training">
            <option value="">All trainings</option>
            @foreach (var c in plan.Coverage) { <option value="@c.CourseCode">@coursesByCode[c.CourseCode].Name</option> }
        </select>
        <a class="btn" download="signup-plan.csv" href="@csvHref">Export plan (CSV)</a>
    </div>
</section>

@foreach (var t in terms)
{
    var assigned = plan.ForTerm(t.Id).ToList();
    <section class="card term">
        <h3>@coursesByCode[t.CourseCode].Name · @Format.Date(t.Date) @Format.TimeRange(t.Start, t.End) · @t.Place
            @if (t.Weekend) { <span class="tag warn"> weekend</span> }</h3>
        <p class="muted">@t.Id · capacity @t.Capacity, booked @t.Booked, free @t.FreeSeats → proposed @assigned.Count, remaining @(t.FreeSeats - assigned.Count)
            @if (t.Price is { } p) { <text> · @Format.Money(p) per person@(t.PriceEstimated ? " (estimate)" : "")</text> }</p>
        <div class="meter">
            <div class="fill" style="width:@Pct(t.Booked + assigned.Count, t.Capacity)"></div>
            <div class="base" style="width:@Pct(t.Booked, t.Capacity)"></div>
        </div>
        <ul class="people">
            @foreach (var a in assigned)
            {
                <li><b>@a.Requirement.Employee.FullName</b> <small class="muted">@a.Requirement.Employee.Department</small> <Badge Status="a.Requirement.Status" />
                    @if (a.Requirement.ValidUntil is { } v && a.Requirement.Status != TrainingStatus.Missing)
                    {
                        <small class="muted"> validity @(a.Requirement.Status == TrainingStatus.Expired ? "ended" : "ends") @Format.Date(v)</small>
                    }
                    @if (a.WillLapse) { <span class="tag warn"> term is after the expiry</span> }</li>
            }
        </ul>
    </section>
}

@if (plan.Unassigned.Count > 0)
{
    <section class="card">
        <h2>Without an assigned term (@plan.Unassigned.Count)</h2>
        <ul class="people">
            @foreach (var u in plan.Unassigned)
            {
                <li><b>@u.Requirement.Employee.FullName</b> – @u.Requirement.Course.Name <Badge Status="u.Requirement.Status" /> <small class="muted">@u.Reason</small></li>
            }
        </ul>
    </section>
}

@code {
    private string course = "";

    private static string Pct(int n, int capacity) =>
        FormattableString.Invariant($"{Math.Min(100.0, capacity == 0 ? 0 : 100.0 * n / capacity):0.#}%");

    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;
}
