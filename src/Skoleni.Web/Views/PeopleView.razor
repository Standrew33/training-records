@implements IDisposable
@inject AppState State

@{
    var f = State.Filter;
    var visible = State.Data.Employees.Where(e => Compliance.GroupOf(e, State.AsOf) != EmployeeGroup.Terminated).ToList();
    var departments = visible.Select(e => e.Department).Distinct().Order().ToList();
    var managers = visible.Select(e => e.ManagerId).Where(id => id is not null).Distinct()
        .Select(id => State.EmployeeById[id!]).OrderBy(m => m.LastName, StringComparer.CurrentCulture).ToList();
    var byEmployee = State.Requirements.ToLookup(r => r.Employee.Id);
    var planned = State.Plan.Assignments.ToDictionary(a => (a.Requirement.Employee.Id, a.Requirement.Course.Code));
    var rows = visible
        .Where(e => f.Department == "" || e.Department == f.Department)
        .Where(e => f.ManagerId == "" || e.ManagerId == f.ManagerId || e.Id == f.ManagerId)
        .Where(e => f.Query == "" || $"{e.FirstName} {e.LastName} {e.Id} {e.Position}".Contains(f.Query, StringComparison.OrdinalIgnoreCase))
        .Select(e =>
        {
            var all = byEmployee[e.Id].Where(r => f.CourseCode == "" || r.Course.Code == f.CourseCode).ToList();
            var hit = all.Where(r => Matches(r)).ToList();
            return (Employee: e, All: all, Hit: hit);
        })
        .Where(x => f.Status == "all" || x.Hit.Count > 0)
        .OrderByDescending(x => x.Hit.Count).ThenBy(x => x.Employee.LastName, StringComparer.CurrentCulture)
        .ToList();
    string csvHref = CsvWriter.ToDataUri(CsvWriter.Write(
        ["ID", "Last name", "First name", "Department", "Position", "Manager", "Training", "Status", "Last completed", "Valid until", "Proposed term"],
        rows.SelectMany(x => x.Hit.Select(r => new string?[]
        {
            x.Employee.Id, x.Employee.LastName, x.Employee.FirstName, x.Employee.Department, x.Employee.Position, State.ManagerName(x.Employee),
            r.Course.Name, Format.Label(r.Status), Format.Date(r.LastCompleted), Format.Date(r.ValidUntil),
            planned.TryGetValue((x.Employee.Id, r.Course.Code), out var a) ? $"{Format.Date(a.Term.Date)} ({a.Term.Id})" : "",
        }))));
}

<section class="card">
    <h2>People and their trainings</h2>
    <div class="filters">
        <input type="search" placeholder="Search name, ID, position…" value="@f.Query" @oninput="e => f.Query = e.Value?.ToString() ?? string.Empty" />
        <select value="@f.Department" @onchange="e => f.Department = e.Value?.ToString() ?? string.Empty" aria-label="Department">
            <option value="">All departments</option>
            @foreach (var d in departments) { <option>@d</option> }
        </select>
        <select value="@f.ManagerId" @onchange="e => f.ManagerId = e.Value?.ToString() ?? string.Empty" aria-label="Manager">
            <option value="">All managers</option>
            @foreach (var m in managers) { <option value="@m.Id">Team: @m.FullName</option> }
        </select>
        <select value="@f.CourseCode" @onchange="e => f.CourseCode = e.Value?.ToString() ?? string.Empty" aria-label="Training">
            <option value="">All trainings</option>
            @foreach (var c in State.Data.Courses.Where(c => c.Audience.Kind != AudienceKind.Optional)) { <option value="@c.Code">@c.Name</option> }
        </select>
        <select value="@f.Status" @onchange="e => f.Status = e.Value?.ToString() ?? ProblemKey" aria-label="Status">
            <option value="problem">Problems only (everything but valid)</option>
            <option value="@nameof(TrainingStatus.Expired)">Expired</option>
            <option value="@nameof(TrainingStatus.Missing)">Missing</option>
            <option value="@nameof(TrainingStatus.ExpiringSoon)">Expiring soon</option>
            <option value="@nameof(TrainingStatus.Valid)">Valid</option>
            <option value="all">Everybody</option>
        </select>
        <a class="btn" download="people-trainings.csv" href="@csvHref">Export CSV</a>
    </div>
    <p class="muted">@rows.Count people</p>
    <div class="tablewrap">
        <table>
            <thead><tr><th>Employee</th><th>Department / position</th><th>Trainings</th></tr></thead>
            <tbody>
            @foreach (var (e, all, hit) in rows)
            {
                var group = Compliance.GroupOf(e, State.AsOf);
                var shown = f.Status == "all" ? all : hit;
                <tr class="clickable" @onclick="() => open = open == e.Id ? null : e.Id">
                    <td><b>@e.FullName</b> <small class="muted">@e.Id</small>
                        @if (group != EmployeeGroup.Active) { <div><span class="tag">@Format.Label(group)</span></div> }</td>
                    <td>@e.Department
                        @if (e.DepartmentInferred) { <span class="tag" title="The department was missing in the data and was inferred"> inferred</span> }
                        <div class="muted">@e.Position</div></td>
                    <td class="chips">
                        @foreach (var r in shown) { <Badge Status="r.Status" Text="@r.Course.Code" /> }
                        @if (shown.Count == 0) { <span class="muted">no obligations</span> }
                    </td>
                </tr>
                @if (open == e.Id)
                {
                    <tr class="detail"><td colspan="3">
                        <div class="muted">Manager: @(e.ManagerId is null ? "none / unknown" : State.ManagerName(e)) · Start: @Format.Date(e.HireDate)@(e.TerminationDate is null ? "" : $" · End: {Format.Date(e.TerminationDate)}")</div>
                        <table class="inner">
                            <thead><tr><th>Training</th><th>Status</th><th>Last completed</th><th>Valid until</th><th>Proposed term</th></tr></thead>
                            <tbody>
                            @foreach (var r in all)
                            {
                                <tr>
                                    <td>@r.Course.Name</td>
                                    <td><Badge Status="r.Status" />
                                        @if (r.DaysLeft is { } days && r.Status != TrainingStatus.Valid) { <small class="muted"> @(days < 0 ? $"{-days} days ago" : $"in {days} days")</small> }</td>
                                    <td>@Format.Date(r.LastCompleted)</td>
                                    <td>@(r.Course.Expires ? Format.Date(r.ValidUntil) : "never expires")</td>
                                    <td>@(planned.TryGetValue((e.Id, r.Course.Code), out var a) ? $"{Format.Date(a.Term.Date)} ({a.Term.Id})" : "–")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </td></tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

@code {
    private const string ProblemKey = "problem";
    private string? open;

    private bool Matches(Requirement r) => State.Filter.Status switch
    {
        "all" => true,
        "problem" => r.NeedsAction,
        var s => r.Status.ToString() == s,
    };

    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;
}
