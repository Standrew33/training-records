@implements IDisposable
@inject AppState State

@{
    var counted = Statistics.Counted(State.Requirements, State.AsOf).ToList();
    var total = StatusCounts.Of(counted);
    var people = State.Data.Employees.Where(e => Compliance.GroupOf(e, State.AsOf) is EmployeeGroup.Active or EmployeeGroup.Starting).ToList();
    var peopleWithProblem = counted.Where(r => r.NeedsAction).Select(r => r.Employee.Id).Distinct().Count();
    var plan = State.Plan;
    var lapsing = plan.Assignments.Where(a => a.WillLapse).ToList();
    var shortages = plan.Coverage.Where(c => c.Shortfall > 0).ToList();
    var onLeave = State.Data.Employees.Count(e => Compliance.GroupOf(e, State.AsOf) == EmployeeGroup.ParentalLeave);
    var excludedTerms = State.Data.Terms.Where(t => t.ExcludedReason is not null).ToList();
    var departments = people.Select(e => e.Department).Distinct().Order().ToList();
}

<section class="kpis">
    <div class="kpi"><div class="n">@Format.Pct(total.OkShare)</div><div>of mandatory trainings in order</div><small>@total.Total obligations across @people.Count people</small></div>
    <button class="kpi click" @onclick="@(() => State.Go(Tab.People, new PeopleFilter { Status = "problem" }))">
        <div class="n bad">@total.Problems</div><div>expired or missing</div><small>@total.Expired expired, @total.Missing missing</small></button>
    <button class="kpi click" @onclick="@(() => State.Go(Tab.People, new PeopleFilter { Status = nameof(TrainingStatus.ExpiringSoon) }))">
        <div class="n soon">@total.ExpiringSoon</div><div>expire within @State.SoonDays days</div><small>until @Format.Date(State.AsOf.AddDays(State.SoonDays))</small></button>
    <button class="kpi click" @onclick="@(() => State.Go(Tab.People))">
        <div class="n">@peopleWithProblem</div><div>people with at least one problem</div><small>of @people.Count</small></button>
</section>

<section class="card">
    <h2>What needs attention</h2>
    <ul class="todo">
        <li><b>@total.Problems</b> mandatory trainings are expired or missing – the plan signs these people up for the nearest free terms.
            <button class="link" @onclick="() => State.Go(Tab.Plan)">Open the plan (@plan.Assignments.Count sign-ups, estimated @Format.Money(plan.EstimatedCost))</button></li>
        @if (lapsing.Count > 0)
        {
            <li><b>@lapsing.Count</b> trainings that are still valid but about to expire <b>will not be renewed in time</b> by any free term
                (@string.Join(", ", lapsing.GroupBy(a => a.Requirement.Course.Code).Select(g => $"{g.Key} {g.Count()}")))
                – the cause is the calendar or full earlier terms; the remedy is to schedule an earlier or additional term.
                <button class="link" @onclick="() => State.Go(Tab.Plan)">Show</button></li>
        }
        @foreach (var s in shortages)
        {
            <li><b>@s.CourseCode</b>: @s.Shortfall seats short – schedule another term.</li>
        }
        @if (shortages.Count == 0)
        {
            <li>The free capacity of the scheduled terms covers all current needs (@plan.Assignments.Count sign-ups).</li>
        }
        @if (onLeave > 0)
        {
            <li>@onLeave people are on parental leave – not counted; handle their trainings before they return.</li>
        }
        @if (excludedTerms.Count > 0)
        {
            <li>@excludedTerms.Count terms in the input data are unusable (@string.Join("; ", excludedTerms.Select(t => $"{t.Id}: {t.ExcludedReason}"))).
                <button class="link" @onclick="() => State.Go(Tab.Quality)">Data quality</button></li>
        }
    </ul>
</section>

<section class="card">
    <h2>Status by training</h2>
    <Legend />
    <div class="rows">
        @foreach (var c in State.Data.Courses.Where(c => c.Audience.Kind != AudienceKind.Optional))
        {
            var rs = counted.Where(r => r.Course.Code == c.Code).ToList();
            if (rs.Count == 0) continue;
            var counts = StatusCounts.Of(rs);
            <div class="row">
                <div class="lbl">
                    <button class="link" @onclick="@(() => State.Go(Tab.People, new PeopleFilter { CourseCode = c.Code }))">@c.Name</button>
                    <small>@rs.Count obligations</small>
                </div>
                <StatusBar Counts="counts" />
                <div class="nums">@counts.Valid / @counts.ExpiringSoon / @counts.Expired / @counts.Missing</div>
            </div>
        }
    </div>
</section>

<section class="card">
    <h2>Status by department</h2>
    <Legend />
    <div class="rows">
        @foreach (var d in departments)
        {
            var rs = counted.Where(r => r.Employee.Department == d).ToList();
            var counts = StatusCounts.Of(rs);
            <div class="row">
                <div class="lbl">
                    <button class="link" @onclick="@(() => State.Go(Tab.People, new PeopleFilter { Department = d }))">@d</button>
                    <small>@people.Count(e => e.Department == d) people · @Format.Pct(counts.OkShare) in order</small>
                </div>
                <StatusBar Counts="counts" />
                <div class="nums">@counts.Valid / @counts.ExpiringSoon / @counts.Expired / @counts.Missing</div>
            </div>
        }
    </div>
</section>

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;
}
