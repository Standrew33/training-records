<div class="stack" role="img" aria-label="Valid @Counts.Valid, expiring soon @Counts.ExpiringSoon, expired @Counts.Expired, missing @Counts.Missing">
    @Seg("ok", Counts.Valid, "Valid")
    @Seg("soon", Counts.ExpiringSoon, "Expiring soon")
    @Seg("bad", Counts.Expired, "Expired")
    @Seg("miss", Counts.Missing, "Missing")
</div>

@code {
    [Parameter, EditorRequired] public StatusCounts Counts { get; set; } = null!;

    private RenderFragment Seg(string css, int n, string label) => n == 0 ? b => { } : b =>
    {
        b.OpenElement(0, "div");
        b.AddAttribute(1, "class", $"seg {css}");
        b.AddAttribute(2, "style", FormattableString.Invariant($"width:{(double)n / Counts.Total * 100:0.##}%"));
        b.AddAttribute(3, "title", $"{label}: {n}");
        b.CloseElement();
    };
}
